# Stream Sync — Rust workspace config
# Copy to: rust/.env
#
# Twitch Developer Console → OAuth Redirect URL:
#   http://localhost:4040/auth/twitch/callback

TWITCH_CLIENT_ID=your_twitch_application_client_id
TWITCH_REDIRECT_URI=http://localhost:4040/auth/twitch/callback
OVERLAY_PORT=4040

# Syndicate API (Stream Sync takeover / connection keys). Guests need no Syndicate login.
# SYNDICATE_API_BASE=https://api.syndicateai.net

# Optional HTTPS update page (Help → Check for updates). Sends app=stream-sync&v=<version>.
# STREAMSYNC_UPDATE_PAGE=https://syndicateai.net/update

# Release builds: `npm run build` copies rust/.env → config/bundled.env (gitignored).
