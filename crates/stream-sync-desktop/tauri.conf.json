{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stream Sync",
  "version": "2.0.1",
  "identifier": "com.kaoticgames.streamsync",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "ui-placeholder"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:* http://localhost:*; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:* https:; img-src 'self' data: https: http://127.0.0.1:* http://localhost:*; style-src 'self' 'unsafe-inline' http://127.0.0.1:* http://localhost:*; script-src 'self' 'unsafe-inline' http://127.0.0.1:* http://localhost:*; font-src 'self' data: http://127.0.0.1:* http://localhost:*; media-src 'self' http://127.0.0.1:* http://localhost:*; frame-src 'none'; object-src 'none'; base-uri 'none'",
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Kaotic Games",
    "icon": [
      "icons/icon.png"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "resources": {
      "../../config/bundled.env": "config/bundled.env",
      "../../overlay-server": "overlay-server",
      "../../views": "views",
      "../../assets": "assets",
      "../../shell.html": "shell.html",
      "../../shell.css": "shell.css",
      "../../boot.html": "boot.html",
      "../../renderer.js": "renderer.js",
      "../../overlay-client-config.js": "overlay-client-config.js",
      "../../tauri-bridge.js": "tauri-bridge.js",
      "../../control-api.js": "control-api.js",
      "../../connections-api.js": "connections-api.js",
      "../../chat-dock-config.js": "chat-dock-config.js",
      "../../chat-overlay-config.js": "chat-overlay-config.js",
      "../../events-dock-config.js": "events-dock-config.js",
      "../../events-overlay-config.js": "events-overlay-config.js",
      "../../events-variation-picker.js": "events-variation-picker.js",
      "../../events-alert-delivery.js": "events-alert-delivery.js",
      "../../events-overlay.js": "events-overlay.js",
      "../../events-se-import.js": "events-se-import.js",
      "../../streamelements-auth-inject.js": "streamelements-auth-inject.js"
    }
  }
}
